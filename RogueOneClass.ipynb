            "-1    47.89916\n",
            "Name: proportion, dtype: float64\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "X_train, X_test, y_train, y_test = train_test_split(features,target,test_size=0.30,random_state=RANDOM_STATE,stratify=target)\n",
        "print(\"\\nTamanho dos conjuntos:\")\n",
        "print(\"Train:\", X_train.shape)\n",
        "print(\"Test:\", X_test.shape)\n",
        "print(\"\\nClasses no TRAIN:\")\n",
        "print(y_train.value_counts())\n",
        "print(\"\\nClasses no TEST:\")\n",
        "print(y_test.value_counts())"
      ],
      "metadata": {
