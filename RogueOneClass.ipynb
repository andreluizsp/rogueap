    {
      "cell_type": "code",
      "source": [
        "# One-Class SVM deve aprender SOMENTE o comportamento normal.\n",
        "normal_mask = y_train == NORMAL_LABEL\n",
        "X_train_normal = X_train[normal_mask]\n",
        "print(\"\\nAmostras normais utilizadas no treinamento:\")\n",
        "print(X_train_normal.shape)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Z5ypWAjaazaK",
        "outputId": "205844a0-32a3-4975-e8f8-22d0b6a61d9a"
