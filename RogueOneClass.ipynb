    {
      "cell_type": "code",
      "source": [
        "# class 1 (normal): data['rogue'] == 1 ]\n",
        "# class 0 (attack): data['rogue'] == -1 ]\n",
        "target = data[\"rogue\"]\n",
        "drop_cols = [\"rogue\",\"Min_MPDCU_Start_Spacing\",\"Max_A_MPDU_Length_Exponent\",\"SM_Power_Save\"]\n",
        "features = data.drop(columns=drop_cols)\n",
        "print(\"\\nDistribuição das classes:\")\n",
        "print(target.value_counts())\n",
        "print(\"\\nDistribuição percentual:\")\n",
        "print(target.value_counts(normalize=True) * 100)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "TOd3sHCDZxpa",
